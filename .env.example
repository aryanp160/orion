# ORION Runtime Configuration
ORION_ENV=development
ORION_LOG_LEVEL=INFO
ORION_API_HOST=0.0.0.0
ORION_API_PORT=8000
ORION_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration
# Local development and tests use SQLite by default
ORION_DATABASE_URL=sqlite+aiosqlite:///./orion.db
# Production PostgreSQL example:
# ORION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/orion

# Redis Configuration (Optional background coordination & cache)
ORION_REDIS_ENABLED=false
ORION_REDIS_URL=redis://localhost:6379/0

# Execution & Mode Controls
# Mode MUST be 'paper' by default for safety. Live execution is disabled by default.
ORION_EXECUTION_MODE=paper
ORION_LIVE_TRADING_ENABLED=false
ORION_OPERATOR_OPT_IN=false
ORION_DEMO_FIXTURES_ENABLED=true

# Auth & API Security
ORION_API_KEY_ENABLED=false
ORION_API_KEY=orion_dev_secret_key_change_in_prod

# Market Data Ingestion & Refresh Settings
ORION_MARKET_DATA_INTERVAL_SEC=2.0
ORION_STALENESS_THRESHOLD_SEC=15.0
ORION_QUOTE_EXPIRY_SEC=30.0

# RPC & External Providers
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ETHEREUM_RPC_URL=https://eth.llamarpc.com
HYPERLIQUID_API_BASE=https://api.hyperliquid.xyz
GMX_API_BASE=https://arbitrum-api.gmxinfra.io

# Default Trading Fee Assumptions (Basis Points)
# Hyperliquid taker: 2.5 - 3.5 bps, maker: -0.2 to 1.0 bps
ORION_HYPERLIQUID_TAKER_FEE_BPS=3.5
ORION_HYPERLIQUID_MAKER_FEE_BPS=1.0
# GMX v2 pool swap/perp fee: ~5 to 7 bps + price impact
ORION_GMX_TRADING_FEE_BPS=5.0

# Pre-Trade Risk Engine Defaults
ORION_MAX_ORDER_NOTIONAL=250000.0
ORION_MAX_POSITION_EXPOSURE=1000000.0
ORION_MAX_PERMITTED_SLIPPAGE_BPS=50.0
ORION_MAX_FEE_BUDGET_BPS=25.0
ORION_MAX_CONCURRENT_ORDERS=10
ORION_PRICE_COLLAR_BPS=100.0
ORION_KILL_SWITCH_ACTIVE=false

# Paper Trading Defaults
ORION_PAPER_INITIAL_EQUITY=100000.0
